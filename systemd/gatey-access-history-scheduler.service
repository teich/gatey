[Unit]
Description=Gatey UniFi access-history synchronizer
Wants=network-online.target
After=network-online.target gatey.service

[Service]
Type=oneshot
User=gatey
Group=gatey
EnvironmentFile=/etc/gatey/gatey.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 50 --request POST --header "Authorization: Bearer ${GATEY_SCHEDULER_SECRET}" http://127.0.0.1:3000/api/internal/access-reconcile
