[Unit]
Description=Gatey UniFi access-history synchronizer
Wants=network-online.target
After=network-online.target gatey.service

[Service]
Type=oneshot
User=gatey
Group=gatey
EnvironmentFile=/etc/gatey/gatey.env
# The secret goes to curl on stdin (echo is a shell builtin), so it never
# appears in the process list.
ExecStart=/bin/sh -c 'echo "Authorization: Bearer $$GATEY_SCHEDULER_SECRET" | exec /usr/bin/curl --fail --silent --show-error --max-time 50 --request POST --header @- http://127.0.0.1:3000/api/internal/access-reconcile'
