# Local Gatey data file. Use an absolute path for systemd deployment.
GATEY_DB_PATH=./data/gatey.sqlite

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000

# Same controller settings used by phone-gate-bridge.
UNIFI_HOST=192.168.2.1
UNIFI_ACCESS_API_TOKEN=replace_me
UNIFI_ACCESS_PORT=12445
UNIFI_INSECURE_TLS=false
UNIFI_DOOR_NAME=Gate

# RTSPS streams stay server-side. Gatey uses FFmpeg to return one authenticated snapshot at a time.
GATEY_CAMERA_PERSON_RTSPS_URL=rtsps://camera.example:7441/person-stream?enableSrtp
GATEY_CAMERA_ROAD_RTSPS_URL=rtsps://camera.example:7441/road-stream?enableSrtp
# Set true only when the camera uses a private/self-signed certificate.
GATEY_CAMERA_INSECURE_TLS=false

# Used only by the production systemd timer to trigger due party modes locally.
GATEY_SCHEDULER_SECRET=replace_with_a_long_random_secret
